<mujoco model="claptrap_scene">
  <include file="claptrap.xml"/>

  <option timestep="0.002" gravity="0 0 -9.81"/>

  <statistic center="0 0 0.15" extent="0.7"/>

  <visual>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.6 0.6 0.6" specular="0.25 0.25 0.25"/>
    <map znear="0.01" zfar="20"/>
    <quality shadowsize="2048" offsamples="4"/>
    <global azimuth="135" elevation="-25" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture name="skybox" type="skybox" builtin="gradient"
             rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/>
    <texture name="floor_grid" type="2d" builtin="checker"
             rgb1="0.18 0.2 0.22" rgb2="0.28 0.3 0.32"
             width="512" height="512" mark="edge" markrgb="0.8 0.8 0.8"/>
    <material name="floor_mat" texture="floor_grid" texrepeat="4 4"
              texuniform="true" reflectance="0.25"/>
  </asset>

  <worldbody>
    <light name="key_light" pos="0 -2 3" dir="0 1 -1"
           directional="true" diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2"/>
    <light name="fill_light" pos="-1.5 1 1.5"
           diffuse="0.25 0.25 0.25" specular="0.05 0.05 0.05"/>

    <camera name="overview" pos="0.7 -1.0 0.65" xyaxes="0.82 0.57 0 -0.26 0.37 0.89"/>
    <camera name="front" pos="0 -1.2 0.35" xyaxes="1 0 0 0 0.25 0.97"/>

    <geom name="floor" type="plane" size="2 2 0.05" material="floor_mat"
          condim="3" friction="1 0.005 0.0001"/>
  </worldbody>
</mujoco>

<mujoco>
  <actuator>
    <motor name="base_link_to_link1_motor"
           joint="base_link_to_link1"
           gear="1"
           ctrllimited="true"
           ctrlrange="-6 6"/>
    <motor name="plane1_to_link2_motor"
           joint="plane1_to_link2"
           gear="1"
           ctrllimited="true"
           ctrlrange="-3 3"/>
  </actuator>

  <sensor>
    <framequat name="imu_plane1_diag_a_orientation"
               objtype="body"
               objname="imu_plane1_diag_a"/>
    <frameangvel name="imu_plane1_diag_a_angular_velocity"
                 objtype="body"
                 objname="imu_plane1_diag_a"/>
    <framelinacc name="imu_plane1_diag_a_linear_acceleration"
                 objtype="body"
                 objname="imu_plane1_diag_a"/>

    <framequat name="imu_plane1_diag_b_orientation"
               objtype="body"
               objname="imu_plane1_diag_b"/>
    <frameangvel name="imu_plane1_diag_b_angular_velocity"
                 objtype="body"
                 objname="imu_plane1_diag_b"/>
    <framelinacc name="imu_plane1_diag_b_linear_acceleration"
                 objtype="body"
                 objname="imu_plane1_diag_b"/>

    <framequat name="imu_plane2_diag_a_orientation"
               objtype="body"
               objname="imu_plane2_diag_a"/>
    <frameangvel name="imu_plane2_diag_a_angular_velocity"
                 objtype="body"
                 objname="imu_plane2_diag_a"/>
    <framelinacc name="imu_plane2_diag_a_linear_acceleration"
                 objtype="body"
                 objname="imu_plane2_diag_a"/>

    <framequat name="imu_plane2_diag_b_orientation"
               objtype="body"
               objname="imu_plane2_diag_b"/>
    <frameangvel name="imu_plane2_diag_b_angular_velocity"
                 objtype="body"
                 objname="imu_plane2_diag_b"/>
    <framelinacc name="imu_plane2_diag_b_linear_acceleration"
                 objtype="body"
                 objname="imu_plane2_diag_b"/>
  </sensor>
</mujoco>

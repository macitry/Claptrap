      <inertia ixx="0.0000001" ixy="0" ixz="0" iyy="0.0000002" iyz="0" izz="0.0000001" />
    </inertial>
  </link>

  <link name="link1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.09" length="0.033" />
      </geometry>
      <material name="walking-wheel-material">
        <color rgba="0.24228112 0.02028856 0.29177065 1.00000000"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.09" length="0.033" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1.54" />
      <inertia ixx="0.003258" ixy="0" ixz="0" iyy="0.003258" iyz="0" izz="0.006237" />
    </inertial>
  </link>

  <link name="link2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.05" length="0.008" />
      </geometry>
      <material name="momentum-wheel-material">
        <color rgba="0.19120168 0.57112483 0.55834039 1.00000000"/>

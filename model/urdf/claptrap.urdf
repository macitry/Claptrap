    <child link="plane2" />
    <origin xyz="4.9303806576313234e-33 0.12 0" rpy="6.07716335728627e-64 0 1.4981364335015033e-95" />
  </joint>
  <link name="plane2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />

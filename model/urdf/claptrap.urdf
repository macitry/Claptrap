      <mass value="0.08" />
      <inertia ixx="0.0000504" ixy="0" ixz="0" iyy="0.0000504" iyz="0" izz="0.0001" />
    </inertial>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 0.1" rpy="0 0 0" />
  </joint>

  <joint name="base_link_to_plane1" type="fixed">
    <parent link="base_link" />
    <child link="plane1" />
    <origin xyz="0 0 0.1" rpy="0 0 0" />
  </joint>

  <joint name="plane1_to_imu_diag_a" type="fixed">
    <parent link="plane1" />
    <child link="imu_plane1_diag_a" />
    <origin xyz="0.065 0.065 0.008" rpy="0 0 0" />
  </joint>

  <joint name="plane1_to_imu_diag_b" type="fixed">
    <parent link="plane1" />
    <child link="imu_plane1_diag_b" />
    <origin xyz="-0.065 -0.065 0.008" rpy="0 0 0" />
  </joint>

  <joint name="plane1_to_plane2" type="fixed">
    <parent link="plane1" />
    <child link="plane2" />
    <origin xyz="0 0 0.12" rpy="0 0 0" />
  </joint>

  <joint name="plane2_to_imu_diag_a" type="fixed">
    <parent link="plane2" />
    <child link="imu_plane2_diag_a" />
    <origin xyz="0.08 0.08 0.008" rpy="0 0 0" />
  </joint>

  <joint name="plane2_to_imu_diag_b" type="fixed">
    <parent link="plane2" />
    <child link="imu_plane2_diag_b" />
    <origin xyz="-0.08 -0.08 0.008" rpy="0 0 0" />
  </joint>

  <joint name="base_link_to_link1" type="continuous">
    <parent link="base_link" />
    <child link="link1" />
    <origin xyz="0 0 0" rpy="1.5707963 0 0" />
    <axis xyz="0 0 1" />
    <limit effort="1000" velocity="30" />
  </joint>

  <joint name="plane1_to_link2" type="continuous">
    <parent link="plane1" />
    <child link="link2" />
    <origin xyz="0 0 0.06" rpy="2.0344439 -1.5707963 1.1071487" />
    <axis xyz="0 0 1" />
    <limit effort="1000" velocity="100" />
  </joint>

</robot>

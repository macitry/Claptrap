<?xml version="1.0"?>
<robot name="claptrap">
  <mujoco>
    <compiler balanceinertia="true" discardvisual="false" fusestatic="false"/>
  </mujoco>

  <link name="base_footprint">
  </link>

  <link name="base_link">
  </link>

  <link name="plane1">
